---
// SubpageNav.astro
interface TocItem {
  id: string;
  label: string;
}

interface SubpageItem {
  id: string;
  label: string;
  href: string;
  children?: SubpageItem[];
}

interface Props {
  items: SubpageItem[];
  activePageId?: string;
  toc?: TocItem[];
  depth?: number;
}

const { items, activePageId, toc = [], depth = 0 } = Astro.props;

const isActiveBranch = (page: SubpageItem): boolean => {
  if (page.id === activePageId) return true;
  return !!page.children?.some((child) => isActiveBranch(child));
};

const TOC_ACTIVE_CLASSES   = "bg-blue-100/70 dark:bg-blue-500/10 text-blue-800 dark:text-blue-300 font-medium";
const TOC_INACTIVE_CLASSES = "text-stone-500 dark:text-slate-500 bg-transparent hover:bg-stone-150/60 dark:hover:bg-white/[0.05] hover:text-stone-800 dark:hover:text-slate-300";
---

<nav class="relative flex flex-col gap-0.5">
  {items.map((page) => {
    const isActive    = page.id === activePageId;
    const isBranch    = isActiveBranch(page);
    const isAnyActive = isActive || isBranch;

    const linkActive   = "bg-blue-100/70 dark:bg-blue-500/10 text-blue-800 dark:text-blue-300";
    const linkInactive = "text-stone-500 dark:text-slate-400 bg-transparent hover:bg-stone-150/60 dark:hover:bg-white/[0.05] hover:text-stone-800 dark:hover:text-slate-200";
    const linkClass    = `rounded-lg px-3.5 py-2 font-mono text-[13px] leading-snug transition-colors duration-150 block ${isAnyActive ? linkActive : linkInactive} ${isActive ? 'font-medium' : ''}`;

    return (
      <div class="relative flex flex-col">

        <a href={page.href} class={linkClass}>
          {page.label}
        </a>

        {page.children && isBranch && (
          <div class="relative ml-3 pl-3 flex flex-col gap-0.5 mt-0.5 mb-1 border-l border-stone-300/50 dark:border-slate-700/60">
            <Astro.self
              items={page.children}
              activePageId={activePageId}
              toc={toc}
              depth={depth + 1}
            />
          </div>
        )}

        {isActive && toc.length > 0 && (
          <div class="relative ml-3 pl-3 flex flex-col gap-0.5 mt-0.5 mb-2 border-l border-stone-300/50 dark:border-slate-700/60">
            {toc.map((item) => (
              <a
                href={`#${item.id}`}
                class={`toc-link rounded-md px-3 py-1.5 font-mono text-[11px] leading-snug transition-colors duration-150 block ${TOC_INACTIVE_CLASSES}`}
                data-active-classes={TOC_ACTIVE_CLASSES}
                data-inactive-classes={TOC_INACTIVE_CLASSES}
              >
                {item.label}
              </a>
            ))}
          </div>
        )}

      </div>
    );
  })}
</nav>