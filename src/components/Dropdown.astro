---
interface Props { title: string; }
const { title } = Astro.props;
---
<details class="group my-3 rounded-lg border border-stone-200 dark:border-slate-800 bg-stone-50/60 dark:bg-white/[0.03] overflow-hidden">
  <summary class="list-none flex items-center gap-2 px-3.5 py-2.5 cursor-pointer select-none font-mono text-[13px] font-medium text-stone-700 dark:text-slate-300 hover:bg-stone-100/80 dark:hover:bg-white/[0.05] transition-colors duration-150">
    <svg
      class="w-3.5 h-3.5 shrink-0 text-stone-400 dark:text-slate-500 transition-transform duration-200 group-open:rotate-90"
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
      stroke-linecap="round" stroke-linejoin="round"
    >
      <polyline points="9 18 15 12 9 6" />
    </svg>
    {title}
  </summary>
  <div class="px-3.5 pb-3.5 pt-1 ml-[22px] border-l border-stone-200 dark:border-slate-800 pl-3.5 text-[13px] leading-relaxed text-stone-600 dark:text-slate-400">
    <slot />
  </div>
</details>