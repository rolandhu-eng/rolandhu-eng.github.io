---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Social/link-preview image. Root-relative path; resolved against `site`. */
  image?: string;
}

const DEFAULT_OG_IMAGE = '/assets/aeolus/avionics/av_bay.webp';

const {
  title = "Roland Hu | Engineering Portfolio",
  description = "Roland Hu - Engineering Portfolio",
  image = DEFAULT_OG_IMAGE,
} = Astro.props;

// Astro.site is set in astro.config.mjs; fall back to a relative URL in dev.
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth scroll-pt-25 dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Roland Hu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.style.background = '#f5f3ef';
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.style.background = '#020817';
        }
      } catch (_) {
        document.documentElement.classList.add('dark');
        document.documentElement.style.background = '#020817';
      }
    </script>

    <style is:global>
      html { background: #020817; }
      html.light { background: #f5f3ef; }

      body, header, footer, nav, main, section, table, tr, td, th {
        transition: background-color 0.5s ease, border-color 0.5s ease, color 0.5s ease;
      }
      
      .katex, .katex *, .math, .math * {
        transition: none !important;
      }

      a, button, video, img { transition: none; }
      a { transition: color 0.5s ease, border-color 0.5s ease, opacity 0.5s ease; }
      button { transition: background-color 0.5s ease, color 0.5s ease, border-color 0.5s ease; }

      #nav-links.open { display: flex; }

      .tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.625rem;
        padding: 0.15rem 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid;
      }
    </style>
  </head>

  <body class="bg-[#f5f3ef] dark:bg-[#020817] text-slate-700 dark:text-slate-300 antialiased font-sans min-h-screen flex flex-col selection:bg-blue-500 selection:text-white">
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:bg-slate-900 focus:text-white focus:font-mono focus:text-xs focus:no-underline">
      Skip to content
    </a>

    <!-- HEADER -->
    <header id="site-header" class="sticky top-0 z-50 w-full border-b bg-[#f5f3ef]/90 dark:bg-[#020817]/90 border-slate-200 dark:border-slate-800 backdrop-blur-sm">
      <div class="max-w-5xl mx-auto px-4 py-3">
        <nav class="flex justify-between items-center">
          <a href="/" class="font-mono text-sm font-bold text-slate-900 dark:text-white tracking-tight hover:text-blue-600 dark:hover:text-blue-400 no-underline">
            Roland Hu
          </a>
          <div class="flex items-center gap-4">
            <ul class="hidden sm:flex items-center gap-6 font-mono text-xs list-none m-0 p-0">
              <li><a href="/#about" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">About</a></li>
              <li><a href="/projects" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">Projects</a></li>
              <li><a href="/#research" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">Research</a></li>
              <li><a href="/#contact" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">Contact</a></li>
            </ul>
            
            <!-- Updated Toggle Button -->
            <button id="theme-toggle" aria-label="Toggle theme" class="flex items-center justify-center w-8 h-8 rounded-full border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-slate-500 dark:hover:border-slate-500 bg-white/60 dark:bg-slate-900/60">
              <!-- Inline SVG rather than ☀/☾ text: Chrome substitutes its colour emoji
                   font for U+2600, Safari renders the monochrome glyph. Swapped by CSS
                   off the .dark class, so there is no icon flash before JS runs. -->
              <svg class="hidden dark:block w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4.2"/>
                <path d="M12 2.6v2.1M12 19.3v2.1M4.4 4.4l1.5 1.5M18.1 18.1l1.5 1.5M2.6 12h2.1M19.3 12h2.1M4.4 19.6l1.5-1.5M18.1 5.9l1.5-1.5"/>
              </svg>
              <svg class="block dark:hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.5 13.3A8.4 8.4 0 1 1 10.7 3.5a6.6 6.6 0 0 0 9.8 9.8z"/>
              </svg>
            </button>

            <button class="nav-toggle sm:hidden p-1.5 border border-slate-300 dark:border-slate-700 rounded" aria-label="Toggle navigation" aria-controls="nav-links" aria-expanded="false">
              <span class="block w-4 h-px bg-slate-600 dark:bg-slate-300 mb-1"></span>
              <span class="block w-4 h-px bg-slate-600 dark:bg-slate-300 mb-1"></span>
              <span class="block w-4 h-px bg-slate-600 dark:bg-slate-300"></span>
            </button>
          </div>
        </nav>
        <ul id="nav-links" class="hidden flex-col gap-3 font-mono text-xs list-none m-0 p-0 border-t border-slate-200 dark:border-slate-800 mt-3 pt-3 pb-1">
          <li><a href="/#about" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">About</a></li>
          <li><a href="/projects" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">Projects</a></li>
              <li><a href="/#research" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">Research</a></li>
          <li><a href="/#contact" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white no-underline">Contact</a></li>
        </ul>
      </div>
    </header>

    <!-- Runs during parsing, before the hero is laid out. Astro's normal <script>
         is a deferred module and lands after first paint, which left the hero
         sized against the 64px fallback and short of the viewport bottom. -->
    <script is:inline>
      (function () {
        var h = document.getElementById('site-header');
        if (h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
      })();
    </script>

    <div id="main-content" tabindex="-1"></div>
    <slot />

    <!-- FOOTER -->
    <footer class="max-w-5xl w-full mx-auto px-4 py-6 border-t border-slate-200 dark:border-slate-800 text-center font-mono text-xs text-slate-400 dark:text-slate-600">
      Designed & Built by Roland Hu | © {year}
    </footer>

    <script>
      function setHeaderHeightVar() {
        const header = document.getElementById('site-header');
        if (header) {
          document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
        }
      }
      setHeaderHeightVar();
      window.addEventListener('resize', setHeaderHeightVar);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(setHeaderHeightVar);
      
      const html = document.documentElement;
      const toggleBtn = document.getElementById('theme-toggle');

      function setTheme(dark: boolean) {
        if (dark) {
          html.classList.add('dark');
          html.style.background = '#020817';
        } else {
          html.classList.remove('dark');
          html.style.background = '#f5f3ef';
        }
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      }

      const saved = localStorage.getItem('theme');
      setTheme(saved !== 'light');

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          setTheme(!html.classList.contains('dark'));
        });
      }

      const navToggle = document.querySelector('.nav-toggle');
      const navLinks = document.getElementById('nav-links');

      if (navToggle && navLinks) {
        navToggle.addEventListener('click', () => {
          navLinks.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', navLinks.classList.contains('open').toString());
        });

        navLinks.querySelectorAll('a').forEach(a => {
          a.addEventListener('click', () => navLinks.classList.remove('open'));
        });
      }
    </script>
  </body>
</html>